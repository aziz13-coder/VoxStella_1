{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxstella.local/schemas/astrocartography/place-goal-model.schema.json",
  "title": "Astrocartography Place Goal Model",
  "description": "Schema for explainable Vox Stella astrocartography place-finder goal profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "version",
    "status",
    "summary",
    "source_status",
    "scoring_engine",
    "score_polarity",
    "composition",
    "evidence_policy",
    "body_scope",
    "score_components",
    "normalization"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "experimental",
        "active",
        "deprecated"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source_status": {
      "$ref": "#/$defs/sourceStatus"
    },
    "scoring_engine": {
      "const": "declarative_components_v2"
    },
    "composition": {
      "$ref": "#/$defs/composition"
    },
    "evidence_policy": {
      "$ref": "#/$defs/evidencePolicy"
    },
    "body_scope": {
      "type": "string",
      "enum": [
        "canonical_ten",
        "extended"
      ]
    },
    "extended_body_policy": {
      "$ref": "#/$defs/extendedBodyPolicy"
    },
    "distance_policy": {
      "$ref": "#/$defs/distancePolicy"
    },
    "transit_strategy": {
      "type": "string",
      "enum": [
        "overlay",
        "ignore"
      ]
    },
    "score_polarity": {
      "type": "string",
      "enum": [
        "higher_is_better",
        "higher_is_worse"
      ]
    },
    "atlas_search_filters": {
      "$ref": "#/$defs/atlasSearchFilters"
    },
    "atlas_shortlist_strategy": {
      "type": "string",
      "enum": [
        "line_first",
        "relocation_prepass"
      ]
    },
    "atlas_relocation_prepass_limit": {
      "type": "integer",
      "minimum": 1
    },
    "goal_family": {
      "type": "string",
      "enum": [
        "education",
        "love",
        "work",
        "money",
        "career",
        "home",
        "partners",
        "personal",
        "friends",
        "beliefs",
        "sex",
        "sex_intimacy",
        "communication",
        "travel",
        "conflict",
        "protection",
        "gambling",
        "risk",
        "custom"
      ]
    },
    "legacy_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legacyRef"
      },
      "default": []
    },
    "ui": {
      "$ref": "#/$defs/uiHints"
    },
    "score_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/lineWeight"
          },
          {
            "$ref": "#/$defs/crossingWeight"
          },
          {
            "$ref": "#/$defs/relocationWeight"
          },
          {
            "$ref": "#/$defs/modifierWeight"
          },
          {
            "$ref": "#/$defs/constraintWeight"
          }
        ]
      }
    },
    "normalization": {
      "$ref": "#/$defs/normalization"
    },
    "explanations": {
      "$ref": "#/$defs/explanations"
    }
  },
  "$defs": {
    "sourceStatus": {
      "type": "string",
      "enum": [
        "direct",
        "synthesis",
        "legacy_parity",
        "experimental"
      ]
    },
    "composition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "standalone"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "parent_id",
            "max_abs_residual"
          ],
          "properties": {
            "mode": {
              "const": "specialist_residual"
            },
            "parent_id": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "parent_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_abs_residual": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_independent_signals",
        "weak_magnitude",
        "strong_magnitude",
        "min_birth_time_confidence",
        "block_caps"
      ],
      "properties": {
        "min_independent_signals": {
          "type": "integer",
          "minimum": 1
        },
        "weak_magnitude": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "strong_magnitude": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_birth_time_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "block_caps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "natal_lines",
            "crossing_interactions",
            "relocation",
            "transit_overlay"
          ],
          "properties": {
            "natal_lines": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "crossing_interactions": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "relocation": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "transit_overlay": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "extendedBodyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "supported",
        "not_scored"
      ],
      "properties": {
        "status": {
          "const": "experimental"
        },
        "supported": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/planet"
          }
        },
        "not_scored": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/planet"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "distancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_profile",
        "sensitivity_profiles"
      ],
      "properties": {
        "primary_profile": {
          "const": "standard"
        },
        "sensitivity_profiles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "conservative",
              "standard",
              "wide"
            ]
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "legacyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_app",
        "source_file",
        "kind"
      ],
      "properties": {
        "source_app": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "pls",
            "hyp",
            "doc",
            "manual"
          ]
        },
        "header_ru": {
          "type": "string"
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "category_token": {
          "type": [
            "integer",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "planet": {
      "type": "string",
      "enum": [
        "Sun",
        "Moon",
        "Mercury",
        "Venus",
        "Mars",
        "Jupiter",
        "Saturn",
        "Uranus",
        "Neptune",
        "Pluto",
        "North Node",
        "South Node",
        "Chiron"
      ]
    },
    "angle": {
      "type": "string",
      "enum": [
        "ASC",
        "DSC",
        "MC",
        "IC"
      ]
    },
    "atlasSearchFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bodies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planet"
          },
          "default": []
        },
        "angles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/angle"
          },
          "default": []
        }
      }
    },
    "distanceBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_km"
      ],
      "properties": {
        "max_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "falloff": {
          "type": "string",
          "enum": [
            "flat",
            "linear",
            "inverse",
            "custom"
          ],
          "default": "linear"
        }
      }
    },
    "lineWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "source_status",
        "kind",
        "planet",
        "angles",
        "weight"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "source_status": {
          "$ref": "#/$defs/sourceStatus"
        },
        "evidence_role": {
          "type": "string",
          "enum": [
            "local",
            "global_prior"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "const": "line"
        },
        "planet": {
          "$ref": "#/$defs/planet"
        },
        "angles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/angle"
          }
        },
        "distance": {
          "$ref": "#/$defs/distanceBand"
        },
        "weight": {
          "type": "number"
        },
        "polarity": {
          "type": "string",
          "enum": [
            "support",
            "caution",
            "neutral"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "crossingWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "source_status",
        "kind",
        "pair",
        "weight"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "source_status": {
          "$ref": "#/$defs/sourceStatus"
        },
        "evidence_role": {
          "type": "string",
          "enum": [
            "local",
            "global_prior"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "const": "crossing"
        },
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/planet"
          }
        },
        "distance": {
          "$ref": "#/$defs/distanceBand"
        },
        "weight": {
          "type": "number"
        },
        "interaction_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "polarity": {
          "type": "string",
          "enum": [
            "support",
            "caution",
            "neutral"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "relocationWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "source_status",
        "kind",
        "weight"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "source_status": {
          "$ref": "#/$defs/sourceStatus"
        },
        "evidence_role": {
          "type": "string",
          "enum": [
            "local",
            "global_prior"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "const": "relocation"
        },
        "houses": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "default": []
        },
        "planets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planet"
          },
          "default": []
        },
        "angles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/angle"
          },
          "default": []
        },
        "weight": {
          "type": "number"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "modifierWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "source_status",
        "kind",
        "metric",
        "weight"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "source_status": {
          "$ref": "#/$defs/sourceStatus"
        },
        "evidence_role": {
          "type": "string",
          "enum": [
            "local",
            "global_prior"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "const": "modifier"
        },
        "metric": {
          "type": "string",
          "enum": [
            "benefic_balance",
            "malefic_pressure",
            "stability",
            "visibility",
            "domesticity",
            "partnership",
            "mobility",
            "uncertainty",
            "community",
            "beliefs",
            "chemistry",
            "career_status",
            "home_base",
            "personal_growth",
            "body_presence",
            "communication",
            "conflict_pressure",
            "asc_ruler_strength",
            "gambling_ruler_strength",
            "asc_gambling_harmony",
            "asc_gambling_tension",
            "moon_gambling_support",
            "moon_liability",
            "retrograde_liability",
            "money_support",
            "travel_joy",
            "restoration",
            "speculation",
            "speculation_drag",
            "health_risk",
            "gambling_signature",
            "gambling_activation",
            "asc_ruler_asc_support",
            "gambling_ruler_asc_support",
            "moon_asc_support",
            "south_node_obstruction",
            "asc_interception",
            "grand_trine_support",
            "kite_support",
            "t_square_pressure",
            "pattern_support",
            "pattern_pressure",
            "custom"
          ]
        },
        "weight": {
          "type": "number"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "constraintWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "source_status",
        "kind",
        "metric",
        "operator",
        "threshold",
        "rationale"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "source_status": {
          "$ref": "#/$defs/sourceStatus"
        },
        "evidence_role": {
          "type": "string",
          "enum": [
            "local",
            "global_prior"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "const": "constraint"
        },
        "metric": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "add": {
          "type": "number"
        },
        "cap_score": {
          "type": "number"
        },
        "polarity": {
          "type": "string",
          "enum": [
            "support",
            "caution",
            "neutral"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "none",
            "zscore",
            "minmax",
            "bounded_linear"
          ],
          "default": "bounded_linear"
        },
        "min_score": {
          "type": "number"
        },
        "max_score": {
          "type": "number"
        },
        "neutral_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "uiHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color_token": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "recommended_order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "explanations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positive_summary": {
          "type": "string"
        },
        "caution_summary": {
          "type": "string"
        },
        "top_factor_template": {
          "type": "string"
        }
      }
    }
  }
}
