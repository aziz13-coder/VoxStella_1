{
  "name": "vox-stella",
  "private": true,
  "version": "2.2.7",
  "homepage": "./",
  "description": "Vox Stella - Traditional Horary Astrology Application",
  "main": "main.js",
  "scripts": {
    "dev": "vite --mode development --port 5173 --strictPort",
    "dev:backend": "cd ../backend && python app.py",
    "build": "vite build",
    "clean": "rimraf dist node_modules/.vite",
    "clean:build": "node scripts/clean-build.js",
    "lint": "eslint . --ext js,jsx --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http-get://localhost:5173/index.html && electron .\"",
    "electron": "electron .",
    "prepare:packaged-backend": "npm run build-backend-exe && npm run prepare-backend",
    "electron:build": "npm run build && npm run prepare:packaged-backend && electron-builder",
    "electron:build:win": "npm run build && npm run prepare:packaged-backend && electron-builder --win",
    "electron:build:win-store": "npm run build && npm run prepare:packaged-backend && electron-builder --win --publish=never",
    "electron:pack": "npm run build && npm run prepare:packaged-backend && electron-builder --dir",
    "start-backend": "cd ../backend && python app.py",
    "prepare-backend": "node scripts/prepare-backend.js",
    "build-backend-exe": "cd ../backend && python build_backend.py",
    "build:production": "npm run clean:build && npm run electron:build:win-store",
    "test:communication": "node test-communication.js",
    "test:packaging": "npm run electron:pack && npm run test:communication",
    "package:working-exe": "node scripts/package-working-exe.js",
    "fix-and-package": "node scripts/fix-and-package.js",
    "build:appx-from-working": "npm run build && npm run build-backend-exe && npm run electron:pack && npm run fix-and-package",
    "validate:icons": "node validate-icons.js",
    "prebuild": "npm run validate:icons",
    "test:unit": "node tests/parseReasoning.test.mjs && node tests/useReasoningFlag.test.mjs && node tests/licenseManagerPolicy.test.mjs && node tests/runtimeEnv.test.cjs && node tests/backendPort.test.cjs",
    "test:ui": "vitest run --config vitest.config.mjs",
    "test": "npm run test:unit && npm run test:ui"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "electron-log": "^5.1.4",
    "electron-updater": "^6.1.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.27",
    "rimraf": "^5.0.1",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5",
    "vitest": "^2.1.8",
    "wait-on": "^7.0.1"
  },
  "author": {
    "name": "Vox Stella Team",
    "email": "support@voxstella.com",
    "url": "https://voxstella.com"
  },
  "license": "Commercial",
  "repository": {
    "type": "git",
    "url": "https://github.com/aziz13-coder/VoxStella_1.git"
  },
  "bugs": {
    "url": "https://github.com/aziz13-coder/VoxStella_1/issues"
  },
  "keywords": [
    "astrology",
    "horary",
    "traditional",
    "divination"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "build": {
    "appId": "com.voxstella.app",
    "productName": "Vox Stella",
    "copyright": "Copyright © 2025 Vox Stella Team",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "main/**/*",
      "preload.js",
      "package.json",
      "license.config.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**/*",
          "!*.pyc",
          "!.env",
          "!horary_api.log",
          "!*.log*",
          "!build/**/*",
          "!*.spec",
          "!dist/**/*",
          "!venv/**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/backend/**/*"
    ],
    "icon": "assets/icon.ico",
    "artifactName": "VoxStella-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vox Stella",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "appx": {
      "applicationId": "VoxStella",
      "backgroundColor": "#1e1e2e",
      "displayName": "Vox Stella",
      "identityName": "VoxStella",
      "publisher": "CN=Vox Stella Team",
      "publisherDisplayName": "Vox Stella Team",
      "languages": [
        "en-US"
      ],
      "addAutoLaunchExtension": false,
      "showNameOnTiles": true,
      "setBuildNumber": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aziz13-coder",
        "repo": "VoxStella_1"
      }
    ],
    "compression": "normal",
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "buildVersion": "2.2.7"
  }
}
