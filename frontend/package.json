{
  "name": "vox-stella",
  "private": true,
  "version": "3.1.7",
  "packageManager": "npm@10.9.8",
  "homepage": "./",
  "description": "Vox Stella - Traditional Horary Astrology Application",
  "main": "main.js",
  "scripts": {
    "dev": "vite --mode development --port 5173 --strictPort",
    "dev:backend": "cd ../backend && python app.py",
    "build": "vite build",
    "clean": "rimraf dist node_modules/.vite",
    "clean:build": "node scripts/clean-build.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http-get://localhost:5173/index.html && electron .\"",
    "electron": "electron .",
    "prepare:packaged-backend": "npm run build-backend-exe && npm run prepare-backend",
    "electron:build": "npm run build && npm run prepare:packaged-backend && electron-builder",
    "electron:build:win": "npm run build && npm run prepare:packaged-backend && electron-builder --win",
    "electron:build:win-store": "npm run build && npm run prepare:packaged-backend && electron-builder --win --publish=never",
    "electron:pack": "npm run build && npm run prepare:packaged-backend && electron-builder --dir",
    "start-backend": "cd ../backend && python app.py",
    "prepare-backend": "node scripts/prepare-backend.js",
    "build-backend-exe": "cd ../backend && python build_backend.py",
    "build:production": "npm run clean:build && npm run electron:build:win-store",
    "test:communication": "node test-communication.js",
    "test:packaging": "npm run electron:pack && npm run test:communication",
    "package:working-exe": "node scripts/package-working-exe.js",
    "fix-and-package": "node scripts/fix-and-package.js",
    "build:appx-from-working": "npm run build && npm run build-backend-exe && npm run electron:pack && npm run fix-and-package",
    "validate:icons": "node validate-icons.js",
    "verify:license-trust-root": "node scripts/verify-production-license-config.mjs",
    "verify:release-runtime": "node scripts/assert-release-runtime.mjs",
    "prebuild": "npm run validate:icons",
    "test:unit": "node tests/parseReasoning.test.mjs && node tests/useReasoningFlag.test.mjs && node tests/licenseManagerPolicy.test.mjs && node tests/licenseManagerPayPalActivation.test.mjs && node main/license.test.cjs && node scripts/prepare-backend.test.cjs && node tests/runtimeEnv.test.cjs && node tests/backendPort.test.cjs && node --test tests/electronRuntimeSecurity.test.cjs",
    "test:ui": "vitest run --config vitest.config.mjs",
    "test": "npm run test:unit && npm run test:ui"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.263.1",
    "node-machine-id": "^1.1.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "tweetnacl": "^1.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.3.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "author": {
    "name": "Vox Stella Team",
    "email": "support@voxstella.com",
    "url": "https://voxstella.com"
  },
  "license": "Commercial",
  "repository": {
    "type": "git",
    "url": "https://github.com/aziz13-coder/VoxStella_1.git"
  },
  "bugs": {
    "url": "https://github.com/aziz13-coder/VoxStella_1/issues"
  },
  "keywords": [
    "astrology",
    "horary",
    "traditional",
    "divination"
  ],
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "build": {
    "appId": "com.voxstella.app",
    "productName": "Vox Stella",
    "copyright": "Copyright © 2025 Vox Stella Team",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "main/**/*",
      "preload.js",
      "package.json",
      "license.config.json"
    ],
    "extraResources": [
      {
        "from": "backend/runtime/horary_backend",
        "to": "backend/runtime/horary_backend",
        "filter": [
          "**/*",
          "!*.log*"
        ]
      }
    ],
    "icon": "assets/icon.ico",
    "artifactName": "VoxStella-Setup-${version}.${ext}",
    "win": {
      "forceCodeSigning": true,
      "signtoolOptions": {
        "certificateSha1": "C3437A82C01A8D773E3004E6EE4B0D584610F59C",
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "nsis": {
      "guid": "c7765e19-78c9-5b2a-a935-14614127ff63",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vox Stella",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "appx": {
      "applicationId": "VoxStella",
      "backgroundColor": "#1e1e2e",
      "displayName": "Vox Stella",
      "identityName": "VoxStella",
      "publisher": "CN=Vox Stella Team",
      "publisherDisplayName": "Vox Stella Team",
      "languages": [
        "en-US"
      ],
      "addAutoLaunchExtension": false,
      "showNameOnTiles": true,
      "setBuildNumber": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aziz13-coder",
        "repo": "VoxStella_1"
      }
    ],
    "compression": "normal",
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "buildVersion": "3.1.7"
  }
}
