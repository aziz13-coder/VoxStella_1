# Copy this file to paypal.env and fill in the real values.
# paypal.env is local-only and must not be committed.

# PayPal REST app credentials. Use live credentials for production, sandbox credentials for sandbox testing.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Public identifiers for the hardened system-browser desktop checkout. These
# are not secrets; never put PAYPAL_CLIENT_SECRET into browser-facing settings.
PAYPAL_DESKTOP_CLIENT_ID=AU6EnBtp-2lZ9HuTzba9ozvumDNGsvmg6ECoAG4p1-XkR2zBh0k2wPgz4Fw_GrONEn_o6tEyKvrkzfxh
PAYPAL_DESKTOP_PLAN_ID=P-83N24493LW950963HNIIXO7Q

# Webhook ID from the PayPal developer dashboard for https://license.voxstella.app/paypal/webhook
PAYPAL_WEBHOOK_ID=

# Production is the default. Uncomment for sandbox testing.
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Accepted subscription plan IDs:
# - P-83N24493LW950963HNIIXO7Q = in-app $25/month offer
# - P-4L214935JK8549417NIAB5KY = website $35/month plan
PAYPAL_ALLOWED_PLAN_IDS=P-83N24493LW950963HNIIXO7Q,P-4L214935JK8549417NIAB5KY
PAYPAL_LICENSE_PLAN=premium-desktop-monthly
PAYPAL_LICENSE_MAX_DEVICES=1

# Website one-time checkout guardrails.
PAYPAL_ONETIME_AMOUNT=250.00
PAYPAL_ONETIME_CURRENCY=USD
PAYPAL_ONETIME_LICENSE_PLAN=premium-desktop-lifetime
PAYPAL_ONETIME_LICENSE_MAX_DEVICES=1

# Required identity contract for every environment that can issue a license,
# including sandbox. Replace both placeholders below with values from the same
# PayPal environment as PAYPAL_API_BASE:
# merchant ID is always required, plus at least one stable product/custom/invoice
# binding. Configure every additional stable field supplied by the checkout.
PAYPAL_PAYEE_MERCHANT_ID=REPLACE_ME_WITH_PRODUCTION_MERCHANT_ID
PAYPAL_ONETIME_PRODUCT_ID=REPLACE_ME_WITH_STABLE_PRODUCT_OR_REFERENCE_ID

# Optional additional stable bindings.
# PAYPAL_ONETIME_CUSTOM_ID=
# PAYPAL_ONETIME_CUSTOM_ID_PREFIX=
# PAYPAL_ONETIME_INVOICE_ID=
# PAYPAL_ONETIME_INVOICE_ID_PREFIX=
# PAYPAL_PAYEE_EMAIL=
